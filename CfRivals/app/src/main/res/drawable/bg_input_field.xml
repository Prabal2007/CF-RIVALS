<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused input -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">

            <corners android:radius="12dp" />

            <solid android:color="?attr/app_background" />

            <stroke
                android:width="2dp"
                android:color="?attr/neon_accent" />

            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp" />

        </shape>
    </item>

    <!-- Normal input -->
    <item>
        <shape android:shape="rectangle">

            <corners android:radius="12dp" />

            <solid android:color="?attr/app_background" />

            <stroke
                android:width="1dp"
                android:color="?attr/app_border" />

        </shape>
    </item>

</selector>