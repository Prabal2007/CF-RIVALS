<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/app_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="34sp"
        android:textColor="?attr/app_text_primary"
        android:fontFamily="sans-serif-black" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        app:dividerColor="?attr/app_text_primary"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/app_card"
        app:strokeWidth="0dp"
        android:layout_marginBottom="30dp"
        android:layout_marginTop="25dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Profile Configuration"
                android:textColor="?attr/neon_accent"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Enter your and your rival's Codeforces handles to start tracking progress."
                android:textColor="?attr/app_text_primary"
                android:textSize="16sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/UserHandle"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Your CF Handle"
                app:boxStrokeColor="?attr/neon_accent"
                app:hintTextColor="?attr/neon_accent"
                app:startIconDrawable="@drawable/ic_avatar"
                app:startIconTint="?attr/neon_accent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editUserHandle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:textColor="?attr/app_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/RivalHandle"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Rival CF Handle"
                app:boxStrokeColor="?attr/neon_accent"
                app:hintTextColor="?attr/neon_accent"
                app:startIconDrawable="@drawable/ic_avatar"
                app:startIconTint="?attr/neon_accent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRivalHandle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:textColor="?attr/app_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="SAVE CHANGES"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:backgroundTint="?attr/neon_accent"
        android:textColor="?attr/colorOnPrimary"
        app:rippleColor="#40000000"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClear"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="Reset Fields"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:backgroundTint="?attr/neon_accent"
        android:textColor="?attr/colorOnPrimary"
        app:rippleColor="#40000000"
        android:textSize="16sp" />

</LinearLayout>