<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Screen title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="?attr/app_text_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <!-- Divider -->
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            app:dividerColor="?attr/app_border" />

        <!-- Profile configuration card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="?attr/app_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="?attr/app_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Section title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Profile Configuration"
                    android:textColor="?attr/neon_accent"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <!-- Description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Enter your and your rival's Codeforces handles to start tracking progress."
                    android:textColor="?attr/app_text_secondary"
                    android:textSize="15sp" />

                <!-- Your handle -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/UserHandle"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="Your CF Handle"
                    app:boxStrokeColor="?attr/neon_accent"
                    app:hintTextColor="?attr/neon_accent"
                    app:startIconDrawable="@drawable/ic_avatar"
                    app:startIconTint="?attr/neon_accent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editUserHandle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:textColor="?attr/app_text_primary"
                        android:textColorHint="?attr/app_text_secondary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Rival handle -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/RivalHandle"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Rival CF Handle"
                    app:boxStrokeColor="?attr/neon_accent"
                    app:hintTextColor="?attr/neon_accent"
                    app:startIconDrawable="@drawable/ic_avatar"
                    app:startIconTint="?attr/neon_accent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editRivalHandle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:textColor="?attr/app_text_primary"
                        android:textColorHint="?attr/app_text_secondary" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Primary action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SAVE CHANGES"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/neon_accent"
            app:cornerRadius="12dp"
            app:rippleColor="#40000000" />

        <!-- Secondary action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="RESET FIELDS"
            android:textColor="?attr/app_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:rippleColor="#40000000"
            app:strokeColor="?attr/app_border"
            app:strokeWidth="1dp" />

    </LinearLayout>

</ScrollView>