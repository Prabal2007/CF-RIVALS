<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.CfRivals" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Application colors -->
        <item name="app_background">@color/background_light</item>
        <item name="app_card">@color/card_light</item>

        <item name="app_text_primary">@color/text_primary_light</item>
        <item name="app_text_secondary">@color/text_secondary_light</item>

        <item name="neon_accent">@color/primary_blue_light</item>
        <item name="app_border">@color/border_light</item>

        <!-- Material 3 -->
        <item name="colorPrimary">@color/primary_blue_light</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSurface">@color/background_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorSurfaceContainer">@color/card_light</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

    </style>

    <style name="Theme.CfRivals" parent="Base.Theme.CfRivals" />

</resources>