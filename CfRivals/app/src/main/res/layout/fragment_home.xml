<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header Battle Area -->
        <View
            android:id="@+id/battleBackground"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_prof_card"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgMe"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar"
            app:layout_constraintEnd_toStartOf="@+id/txtVs"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/battleBackground"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="?attr/neon_accent"
            app:strokeWidth="3dp" />

        <TextView
            android:id="@+id/txtVs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VS"
            android:textColor="?attr/neon_accent"
            android:textSize="36sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            app:layout_constraintBottom_toBottomOf="@+id/imgMe"
            app:layout_constraintEnd_toStartOf="@+id/imgRival"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/imgMe"
            app:layout_constraintTop_toTopOf="@+id/imgMe" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgRival"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/txtVs"
            app:layout_constraintTop_toTopOf="@id/battleBackground"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="#FF4444"
            app:strokeWidth="3dp" />

        <TextView
            android:id="@+id/txtUserHandle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="You"
            android:textColor="?attr/app_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/imgMe"
            app:layout_constraintStart_toStartOf="@+id/imgMe"
            app:layout_constraintTop_toBottomOf="@+id/imgMe" />

        <TextView
            android:id="@+id/txtRivalHandle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Rival"
            android:textColor="?attr/app_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/imgRival"
            app:layout_constraintStart_toStartOf="@+id/imgRival"
            app:layout_constraintTop_toBottomOf="@+id/imgRival" />

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="?attr/app_card"
            app:cardCornerRadius="20dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1AFFFFFF"
            app:layout_constraintTop_toBottomOf="@+id/battleBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtRatingGap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="FETCHING DATA..."
                    android:textColor="?attr/neon_accent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="?attr/app_text_secondary"
                    android:alpha="0.2" />

                <!-- Comparison Table -->
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1,2">

                    <TableRow android:layout_marginBottom="12dp">
                        <TextView
                            android:text="Metric"
                            android:textColor="?attr/app_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:text="YOU"
                            android:gravity="center"
                            android:textColor="?attr/app_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:text="RIVAL"
                            android:gravity="center"
                            android:textColor="?attr/app_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <TableRow android:layout_marginBottom="16dp">
                        <TextView
                            android:text="Rating"
                            android:textColor="?attr/app_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtMeRating"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="?attr/neon_accent"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtRivalRating"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="#FF4444"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:text="Solved"
                            android:textColor="?attr/app_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtMeSolved"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="?attr/neon_accent"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtRivalSolved"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="#FF4444"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </TableRow>
                </TableLayout>

                <!-- Dominance Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="BATTLE DOMINANCE"
                    android:textColor="?attr/app_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/dominanceBar"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="12dp"
                    android:progress="50"
                    app:indicatorColor="?attr/neon_accent"
                    app:trackColor="#FF4444"
                    app:trackCornerRadius="6dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Winning"
                        android:textColor="?attr/neon_accent"
                        android:textSize="10sp"
                        android:layout_alignParentStart="true" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Losing"
                        android:textColor="#FF4444"
                        android:textSize="10sp"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>