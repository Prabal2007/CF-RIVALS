<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header Battle Area -->
        <View
            android:id="@+id/battleBackground"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_prof_card"
            app:layout_constraintTop_toTopOf="parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/battleBackground"
            app:layout_constraintBottom_toBottomOf="@id/battleBackground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgMe"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar"
            app:layout_constraintEnd_toStartOf="@+id/txtVs"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/battleBackground"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="?attr/neon_accent"
            app:strokeWidth="3dp" />

        <TextView
            android:id="@+id/txtVs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VS"
            android:textColor="?attr/neon_accent"
            android:textSize="36sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            app:layout_constraintBottom_toBottomOf="@+id/imgMe"
            app:layout_constraintEnd_toStartOf="@+id/imgRival"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/imgMe"
            app:layout_constraintTop_toTopOf="@+id/imgMe" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgRival"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/txtVs"
            app:layout_constraintTop_toTopOf="@id/battleBackground"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="#FF4444"
            app:strokeWidth="3dp" />

        <TextView
            android:id="@+id/txtUserHandle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="You"
            android:textColor="?attr/app_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/imgMe"
            app:layout_constraintStart_toStartOf="@+id/imgMe"
            app:layout_constraintTop_toBottomOf="@+id/imgMe" />

        <TextView
            android:id="@+id/txtRivalHandle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Rival"
            android:textColor="?attr/app_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/imgRival"
            app:layout_constraintStart_toStartOf="@+id/imgRival"
            app:layout_constraintTop_toBottomOf="@+id/imgRival" />

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="?attr/app_card"
            app:cardCornerRadius="20dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1AFFFFFF"
            app:layout_constraintTop_toBottomOf="@+id/battleBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Rating Difference -->
                <TextView
                    android:id="@+id/txtRatingGap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="FETCHING DATA..."
                    android:textColor="?attr/neon_accent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="?attr/app_text_secondary"
                    android:alpha="0.2" />

                <!-- Comparison Table -->
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1,2">

                    <TableRow
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:text="Metric"
                            android:textColor="?attr/app_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:gravity="center"
                            android:text="YOU"
                            android:textColor="?attr/app_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:gravity="center"
                            android:text="RIVAL"
                            android:textColor="?attr/app_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </TableRow>

                    <!-- Rating Row -->
                    <TableRow
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:text="Rating"
                            android:textColor="?attr/app_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtMeRating"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="?attr/neon_accent"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtRivalRating"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="#FF4444"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </TableRow>

                    <!-- Solved Row -->
                    <TableRow>

                        <TextView
                            android:text="Solved"
                            android:textColor="?attr/app_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtMeSolved"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="?attr/neon_accent"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtRivalSolved"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="#FF4444"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </TableRow>

                </TableLayout>

                <!-- Solved Problem Difference -->
                <TextView
                    android:id="@+id/txtSolvedGap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="--"
                    android:textColor="?attr/app_text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Dominance Section -->
                <TextView
                    android:id="@+id/txtBattleDominance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="BATTLE DOMINANCE"
                    android:textColor="?attr/app_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <!-- Dominance Bar -->
                <LinearLayout
                    android:id="@+id/dominanceBarContainer"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:clipToOutline="true"
                    android:background="@drawable/bg_dominance_track">

                    <View
                        android:id="@+id/dominanceYou"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="50"
                        android:background="#39FF88" />

                    <View
                        android:id="@+id/dominanceRival"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="50"
                        android:background="#FF4545" />

                </LinearLayout>

                <!-- Dominance Labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtYouDominance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="YOU"
                        android:textColor="#39FF88"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRivalDominance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="RIVAL"
                        android:textColor="#FF4545"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Retry Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Retry"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statsCard" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>