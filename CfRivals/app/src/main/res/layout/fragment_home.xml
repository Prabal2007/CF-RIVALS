<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- ========================================================= -->
        <!-- BATTLE HEADER                                             -->
        <!-- ========================================================= -->

        <View
            android:id="@+id/battleBackground"
            android:layout_width="match_parent"
            android:layout_height="205dp"
            android:background="@drawable/bg_prof_card"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/battleBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/battleBackground" />

        <!-- YOUR AVATAR -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgMe"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Your Codeforces profile picture"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar"
            app:layout_constraintEnd_toStartOf="@id/txtVs"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/battleBackground"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="?attr/neon_accent"
            app:strokeWidth="3dp" />

        <!-- VS -->
        <TextView
            android:id="@+id/txtVs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:shadowColor="#60000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="VS"
            android:textColor="?attr/neon_accent"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/imgMe"
            app:layout_constraintEnd_toStartOf="@id/imgRival"
            app:layout_constraintStart_toEndOf="@id/imgMe"
            app:layout_constraintTop_toTopOf="@id/imgMe" />

        <!-- RIVAL AVATAR -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgRival"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Rival's Codeforces profile picture"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@id/txtVs"
            app:layout_constraintTop_toTopOf="@id/battleBackground"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="@color/rival_red"
            app:strokeWidth="3dp" />

        <!-- YOUR HANDLE -->
        <TextView
            android:id="@+id/txtUserHandle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="You"
            android:textColor="?attr/app_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/imgMe"
            app:layout_constraintStart_toStartOf="@id/imgMe"
            app:layout_constraintTop_toBottomOf="@id/imgMe" />

        <!-- RIVAL HANDLE -->
        <TextView
            android:id="@+id/txtRivalHandle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Rival"
            android:textColor="?attr/app_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/imgRival"
            app:layout_constraintStart_toStartOf="@id/imgRival"
            app:layout_constraintTop_toBottomOf="@id/imgRival" />

        <!-- ========================================================= -->
        <!-- COMPARISON CARD                                           -->
        <!-- ========================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="?attr/app_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/app_border"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/battleBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Rating Difference -->
                <TextView
                    android:id="@+id/txtRatingGap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="FETCHING DATA..."
                    android:textColor="?attr/neon_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:alpha="0.25"
                    android:background="?attr/app_border" />

                <!-- ================================================= -->
                <!-- COMPARISON TABLE                                  -->
                <!-- ================================================= -->

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1,2">

                    <!-- Header -->
                    <TableRow
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="METRIC"
                            android:textColor="?attr/app_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="YOU"
                            android:textColor="@color/you_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="RIVAL"
                            android:textColor="@color/rival_red"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </TableRow>

                    <!-- Rating -->
                    <TableRow
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:text="Rating"
                            android:textColor="?attr/app_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtMeRating"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="@color/you_green"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtRivalRating"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="@color/rival_red"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </TableRow>

                    <!-- Solved -->
                    <TableRow>

                        <TextView
                            android:text="Solved"
                            android:textColor="?attr/app_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtMeSolved"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="@color/you_green"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtRivalSolved"
                            android:gravity="center"
                            android:text="--"
                            android:textColor="@color/rival_red"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </TableRow>

                </TableLayout>

                <!-- Solved Difference -->
                <TextView
                    android:id="@+id/txtSolvedGap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="--"
                    android:textColor="?attr/app_text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- ================================================= -->
                <!-- DOMINANCE                                          -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/txtBattleDominance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:letterSpacing="0.08"
                    android:text="BATTLE DOMINANCE"
                    android:textColor="?attr/app_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Dominance Bar -->
                <LinearLayout
                    android:id="@+id/dominanceBarContainer"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_dominance_track"
                    android:clipToOutline="true"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dominanceYou"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="50"
                        android:background="@color/you_green" />

                    <View
                        android:id="@+id/dominanceRival"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="50"
                        android:background="@color/rival_red" />

                </LinearLayout>

                <!-- Dominance Labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtYouDominance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="YOU"
                        android:textColor="@color/you_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRivalDominance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="RIVAL"
                        android:textColor="@color/rival_red"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================================= -->
        <!-- RETRY BUTTON                                              -->
        <!-- ========================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Retry"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="?attr/neon_accent"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statsCard" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>